<Window x:Class="Xbar.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Xbar.Localization"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        ResizeMode="NoResize"
        Focusable="False"
        AllowDrop="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Title="Xbar">

    <Grid>

        <!--
            Etiquette du bouton survole (mode « nom au survol du bouton »). Elle vit dans la zone
            libre a gauche de la barre. IsHitTestVisible=False : elle ne doit jamais intercepter
            un clic destine a l'Explorateur.
        -->
        <Grid x:Name="ItemLabelHost"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Visibility="Collapsed"
              IsHitTestVisible="False">
        <Border x:Name="ItemLabel"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                CornerRadius="8"
                Padding="12,6,12,7"
                BorderThickness="1"
                Background="{DynamicResource ToastBackground}"
                BorderBrush="{DynamicResource BarBorder}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Opacity="0.3" Color="#000000" />
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="ItemLabelSlide" />
            </Border.RenderTransform>
            <TextBlock x:Name="ItemLabelText"
                       Foreground="{DynamicResource BarForeground}"
                       TextTrimming="CharacterEllipsis" />
        </Border>
        </Grid>

    <Border x:Name="BarRoot"
            HorizontalAlignment="Right"
            ClipToBounds="True"
            CornerRadius="10"
            Padding="4"
            BorderThickness="1"
            Background="{DynamicResource BarBackground}"
            BorderBrush="{DynamicResource BarBorder}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Opacity="0.35" Color="#000000" />
        </Border.Effect>

        <StackPanel Orientation="Vertical">

            <!-- Poignee : glisser verticalement pour repositionner la barre -->
            <Border x:Name="DragGrip"
                    Height="3"
                    CornerRadius="1.5"
                    Margin="7,1,7,5"
                    Background="{DynamicResource GripBrush}"
                    Cursor="SizeNS"
                    ToolTip="{loc:Loc Bar_GripTooltip}" />

            <StackPanel x:Name="ItemsHost" Orientation="Vertical" />

            <!-- Pastilles de configuration : une par liste de raccourcis, la pleine est l'active -->
            <StackPanel x:Name="ProfileHost"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,4,0,0" />
        </StackPanel>
    </Border>

    </Grid>
</Window>
